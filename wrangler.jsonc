{
  // Static assets only: `npm run build` writes dist/, and this Worker serves it.
  // Without this file `wrangler deploy` reads the Vite config, assumes a Workers
  // app, and tries to add the Cloudflare Vite plugin to it, which fails before
  // the site is ever built.
  "name": "ali-srouji-portfolio",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
