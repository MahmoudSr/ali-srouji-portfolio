{
  // Static assets only: `npm run build` writes dist/, and this Worker serves it.
  // Without this file `wrangler deploy` reads the Vite config, assumes a Workers
  // app, and tries to add the Cloudflare Vite plugin to it, which fails before
  // the site is ever built.
  "name": "ali-srouji-portfolio",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    // The site is one page with no client-side routes, so a path that does not
    // exist is a mistake and should say so. Under "single-page-application" a
    // missing file answers 200 with index.html, which would have handed the
    // messengers fetching og:image a page of HTML instead of the card.
    "not_found_handling": "none"
  }
}
